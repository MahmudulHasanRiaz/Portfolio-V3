# V3 needs legacy peer resolution (2026-11-13, see docs/VERSIONS.md):
# TypeScript 7 is the pinned major, but three latest packages still declare
# peer ranges that exclude it (@astrojs/check ^5||^6, typescript-eslint
# <6.1.0, @sveltejs/kit ^6 via better-auth). None of those peers is in the
# build path (tsc / next build / astro build), so the install is forced
# past the declarations and the build itself verifies TS 7 works.
# Remove this once those packages declare TS 7 support, then re-install
# without the flag and confirm the tree still resolves.
legacy-peer-deps=true
