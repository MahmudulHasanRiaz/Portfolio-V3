# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/personal_brand_os
DATABASE_POOL_URL=postgresql://user:pass@localhost:5432/personal_brand_os

# ─── Authentication ────────────────────────────────────
BETTER_AUTH_SECRET=your-secret-here-min-64-chars
BETTER_AUTH_URL=http://localhost:3000

# ─── Storage (Cloudflare R2) ───────────────────────────
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=r2-access-key
R2_SECRET_ACCESS_KEY=r2-secret-key
R2_BUCKET=personal-brand-os-dev
R2_PUBLIC_URL=http://localhost:3000

# ─── Email (Resend) ────────────────────────────────────
RESEND_API_KEY=re_example
RESEND_FROM_EMAIL=noreply@example.com
RESEND_FROM_NAME=Mahmudul Hasan Riaz

# ─── Monitoring (Sentry) ───────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://example@example.ingest.sentry.io/project
SENTRY_AUTH_TOKEN=
SENTRY_ORG=personal-brand-os
SENTRY_PROJECT=personal-brand-os

# ─── Analytics ─────────────────────────────────────────
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_SITE_ID=

# ─── Notifications ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Cron ──────────────────────────────────────────────
CRON_SECRET=your-cron-secret-min-64-chars

# ─── Public site cache purge (Portfolio-Public) ────────────
# The public Astro site caches pages at the edge for 1 h; the admin purges
# the affected tags on every content save via POST <PUBLIC_SITE_URL>/api/cache/invalidate.
# CACHE_INVALIDATE_SECRET must match the Cloudflare dashboard secret of the same
# name on the public Worker. If either is unset, saves still succeed — pages just
# stay cached up to the 1 h TTL. Never commit a real secret here.
PUBLIC_SITE_URL=https://portfolio-public.riaaz.workers.dev
CACHE_INVALIDATE_SECRET=

# ─── Application ───────────────────────────────────────
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Mahmudul Hasan Riaz
NEXT_PUBLIC_SITE_DESCRIPTION=Software Engineer, Entrepreneur, Islamic Artist
LOG_LEVEL=debug
