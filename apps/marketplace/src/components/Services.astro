---
import { SERVICES, type Service } from "../data/site";
import ServiceCards from "./ServiceCards.astro";
import { getDict, langUrl, type Lang } from "../lib/i18n";
import { HOMEPAGE_SERVICES_LIMIT } from "../lib/homepage-limits";

interface Props {
	lang?: Lang;
	/** Live-merged services (getServices()); defaults to build-time SERVICES. */
	services?: Service[];
}

const { lang = "en", services = SERVICES } = Astro.props;
// The services-grid CSS is designed for exactly 5 cards (3+2 at
// >=1024px) — a 6th card would break the layout, so cap the preview
// here (and pass the same capped list to the modal). The full listing
// lives on the /services/ archive page.
const visibleServices = services.slice(0, HOMEPAGE_SERVICES_LIMIT);
const t = getDict(lang);
---

<section class="glass section" id="services">
	<div class="section-head">
		<div>
			<h2>{t.servicesTitle}</h2>
		</div>
		<a class="view-all" href={langUrl("/services", lang)}>{t.viewAllServices}</a>
	</div>
	<ServiceCards services={visibleServices} lang={lang} />
</section>
