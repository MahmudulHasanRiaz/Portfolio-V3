---
import { getClients } from "../lib/content";
import { applySiteCopy, getDict, localizeData, type Lang } from "../lib/i18n";
import { getSiteSettings } from "../lib/settings";
import { optimizedImageUrl } from "../lib/images";

interface Props {
	lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = applySiteCopy(getDict(lang), lang, await getSiteSettings());

// Live clients over the build-time CLIENTS fallback — until the API
// `clients` type exists this is the same 2 rows. How a client renders:
//   - no logo: the text wordmark (the name), exactly as before.
//   - logo + mode "name_logo": a square 36px icon BESIDE the name
//     (for 1:1 icon-style logos that do NOT contain the name).
//   - logo + mode "logo" (or no mode — the default): just the logo
//     image (for wide logos that already contain the name).
// A files.riaz.com.bd logo goes through /api/image at width 144
// (clamped to the 360 minimum — a 36px logo never needs more);
// any other logo URL renders unchanged. The cell links out only
// when a real `website` exists, and a linked name never shows an
// underline (`.client-cell` sets `text-decoration: none`) — the
// name looks like plain text even though it is clickable.
//
// The wall is a seamless, continuous marquee — NOT a slider. The
// client list renders twice and the track glides left at one steady
// speed, looping without ever jumping back to the first client.
// The duration scales with the client count (6s per client, ~30s
// for the 5 today — Fixed Plus, Avelto, Plus Time, Your Choice,
// Kidzen), so the speed stays constant as clients are added.
// With fewer than 2 clients the row is static (no animation, no
// duplicate). Hover/focus pauses it; prefers-reduced-motion stops
// it entirely (CSS). With no clients at all the section renders
// nothing — never an empty heading.
const clients = (await getClients()).map((c) =>
	localizeData({ ...c }, lang),
);
const marquee = clients.length >= 2;
// One steady speed: 6s of travel per client in a set.
const duration = `${clients.length * 6}s`;
---

{
	clients.length > 0 && (
		<section class="glass section" id="clients" data-clients>
			<div class="section-head">
				<h2>{t.clientsTitle}</h2>
			</div>
			<div class="clients-viewport">
				<div
					class={
						marquee
							? "clients-track clients-track--marquee"
							: "clients-track"
					}
					style={
						marquee ? `--marquee-duration: ${duration}` : undefined
					}
				>
					{[0, 1].map((copy) => {
						if (copy === 1 && !marquee) return null;
						return (
							<div
								class="clients-set"
								aria-hidden={copy === 1 ? "true" : undefined}
							>
								{clients.map((client) => {
									const nameLogo =
										client.logo_url &&
										client.logo_display_mode ===
											"name_logo";
									const inner = nameLogo ? (
										<>
											<img
												class="client-logo-icon"
												src={optimizedImageUrl(
													client.logo_url,
													144,
												)}
												alt=""
												loading="lazy"
												decoding="async"
											/>
											<span class="client-wordmark">
												{client.name}
											</span>
										</>
									) : client.logo_url ? (
										<>
											<img
												src={optimizedImageUrl(
													client.logo_url,
													144,
												)}
												alt={client.name}
												loading="lazy"
												decoding="async"
											/>
											<span class="client-wordmark client-wordmark--fallback">
												{client.name}
											</span>
										</>
									) : (
										<span class="client-wordmark">
											{client.name}
										</span>
									);
									const cellClass = nameLogo
										? "client-cell client-cell--name-logo"
										: "client-cell";
									return client.website ? (
										<a
											class={cellClass}
											href={client.website}
											target="_blank"
											rel="noopener noreferrer"
											tabindex={
												copy === 1 ? "-1" : undefined
											}
										>
											{inner}
										</a>
									) : (
										<div class={cellClass}>{inner}</div>
									);
								})}
							</div>
						);
					})}
				</div>
			</div>
		</section>
	)
}

<script>
	// A logo URL that 404s must never leave a broken-image icon:
	// hide the img and show the wordmark fallback instead.
	const root = document.querySelector<HTMLElement>("[data-clients]");
	if (root) {
		root.querySelectorAll("img").forEach((img) => {
			const markBroken = () => img.classList.add("is-broken");
			if (img.complete && img.naturalWidth === 0) markBroken();
			else img.addEventListener("error", markBroken);
		});
	}
</script>
