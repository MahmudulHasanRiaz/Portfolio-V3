---
// ArchiveFilter — ONE shared filter control for every archive page
// (projects, posts, ventures, releases — EN + BN).
//
// MOBILE-FIRST: a single horizontally scrollable chip row. ALL
// categories are chips in the row — there is NO "More" button and NO
// dropdown. The old "More +" pattern hid categories behind an extra
// tap, and its dropdown overflowed off the left edge and overlapped
// the content below on mobile. The row scrolls (swipe on touch,
// wheel/drag on desktop), the scrollbar is hidden, a stronger edge
// fade hints that there is more, and tapping a chip scrolls it fully
// into view. The list grows without breaking: chips just extend the
// row. The "All" chip is pinned to the left edge (sticky) so it stays
// reachable after a right-side chip is picked — the row used to
// scroll it out of view, hiding the reset.
//
//   - "All" + every option, sorted by item count desc (ties:
//     alphabetical), so the biggest categories are visible first.
//   - Every chip shows its item count (the counts used to live in
//     the dropdown; they now live on the chips themselves).
//   - The active filter chip is highlighted.
//
// URL STATE (?filter=): the active filter is reflected in the URL
// (e.g. /projects/?filter=E-commerce), so it survives reloads, is
// shareable/bookmarkable, and card tag pills can link to it. The
// filter reads the param on load and applies it; "all" leaves the
// URL clean (no param). An unknown value falls back to "all" and the
// param is dropped.
//
// Filtering is still client-side, no framework, one tiny inline
// script: cards are matched per `mode` — "card-tag-text" (projects:
// a .tag descendant's text), "card-data-tags" (posts/ventures: the
// card's data-tags CSV), "card-data-type" (releases: the card's
// data-type). Counts are computed by the page from the same data it
// already renders and passed in as `items`.
//
// RESILIENCE: the chip handler is delegated on `document` (bound
// once) and the filter re-wires on every `astro:page-load`, so the
// filter keeps working after a client-side navigation (e.g. the
// EN↔BN language switch) without a reload — the same pattern the
// lightbox in detail.js uses. (The general language-switch race is
// PR #16's root-cause fix; this is only the filter's own wiring.)
interface FilterItem {
	value: string;
	label: string;
	count: number;
}

interface Props {
	items: FilterItem[];
	allLabel: string;
	mode: "card-tag-text" | "card-data-tags" | "card-data-type";
	gridSelector: string;
	countSelector: string;
	cardSelector: string;
	id?: string;
	style?: string;
}

const {
	items,
	allLabel,
	mode,
	gridSelector,
	countSelector,
	cardSelector,
	id,
	style,
} = Astro.props;

// Biggest categories first (ties: alphabetical), so the row opens on
// the most relevant chips and the rest are a swipe away. Every option
// is a chip — nothing is hidden behind a menu.
const sorted = [...items].sort(
	(a, b) => b.count - a.count || a.label.localeCompare(b.label),
);
---

<div
	class="chip-row"
	id={id}
	style={style}
	data-archive-filter
	data-mode={mode}
	data-grid={gridSelector}
	data-count={countSelector}
	data-card={cardSelector}
>
	<button
		type="button"
		class="chip active"
		data-filter="all"
		aria-pressed="true"
	>
		{allLabel}
	</button>
	{
		sorted.map((item) => (
			<button
				type="button"
				class="chip"
				data-filter={item.value}
				aria-pressed="false"
			>
				{item.label}
				<span class="chip-count" aria-hidden="true">
					{item.count}
				</span>
			</button>
		))
	}
</div>

<script is:inline>
	// Archive filter (shared ArchiveFilter.astro): a horizontally
	// scrollable chip row. Tapping a chip filters the cards by the
	// page's matching mode; the active filter lives in the URL
	// (?filter=) so it survives reloads and is shareable.
	(function () {
		var PARAM = "filter";

		function readFilterFromUrl() {
			try {
				var v = new URLSearchParams(window.location.search).get(
					PARAM,
				);
				return v ? v : "all";
			} catch (e) {
				return "all";
			}
		}

		function writeFilterToUrl(value) {
			try {
				var url = new URL(window.location.href);
				if (!value || value === "all")
					url.searchParams.delete(PARAM);
				else url.searchParams.set(PARAM, value);
				window.history.replaceState(null, "", url.toString());
			} catch (e) {
				/* URL unavailable — the filter still applies in place. */
			}
		}

		function matches(card, mode, value) {
			if (value === "all") return true;
			if (mode === "card-data-tags") {
				var tags = (card.getAttribute("data-tags") || "")
					.split(",")
					.map(function (s) {
						return s.trim();
					});
				return tags.indexOf(value) !== -1;
			}
			if (mode === "card-data-type") {
				return card.getAttribute("data-type") === value;
			}
			// card-tag-text (projects): a .tag descendant's text.
			var tagEls = card.querySelectorAll(".tag");
			for (var i = 0; i < tagEls.length; i++) {
				if ((tagEls[i].textContent || "").trim() === value)
					return true;
			}
			return false;
		}

		// Apply a filter value to one filter root. Everything is
		// derived from the live DOM, so no state goes stale across
		// client-side navigations.
		function applyFilter(root, value, opts) {
			opts = opts || {};
			var mode = root.getAttribute("data-mode");
			var gridSel = root.getAttribute("data-grid");
			var grid = gridSel ? document.querySelector(gridSel) : null;
			if (!grid) return;
			var cardSel = root.getAttribute("data-card") || ".grid-card";
			var cards = Array.prototype.slice.call(
				grid.querySelectorAll(cardSel),
			);
			var countSel = root.getAttribute("data-count");
			var countEl = countSel
				? document.querySelector(countSel)
				: null;
			var total = cards.length;
			var template = countEl
				? countEl.getAttribute("data-count-template") || ""
				: "";
			var fmt = function (n) {
				return template.indexOf("টি") !== -1
					? n.toLocaleString("bn-BD")
					: String(n);
			};
			var shown = 0;
			cards.forEach(function (card) {
				var show = matches(card, mode, value);
				card.style.display = show ? "" : "none";
				if (show) shown++;
			});
			var activeChip = null;
			root.querySelectorAll(".chip[data-filter]").forEach(
				function (chip) {
					var active =
						chip.getAttribute("data-filter") === value;
					chip.classList.toggle("active", active);
					chip.setAttribute(
						"aria-pressed",
						active ? "true" : "false",
					);
					if (active) activeChip = chip;
				},
			);
			if (countEl) {
				countEl.textContent = template
					? template
							.replace("{shown}", fmt(shown))
							.replace("{total}", fmt(total))
					: "Showing " + shown + " of " + total;
			}
			// Keep the tapped chip fully visible in the scrollable
			// row (a chip half cut off at the edge scrolls in).
			// Skipped on load: the page must not jump when it opens
			// on a filtered URL.
			if (
				opts.scroll !== false &&
				activeChip &&
				typeof activeChip.scrollIntoView === "function"
			) {
				activeChip.scrollIntoView({
					behavior: "smooth",
					inline: "nearest",
					block: "nearest",
				});
			}
			if (opts.syncUrl !== false) writeFilterToUrl(value);
		}

		// Edge fades: hint that the row scrolls. The CSS fades the
		// right edge while there is more to the right; these classes
		// describe where the scroll position is so the fade stays
		// truthful as the user swipes. (The left edge needs no fade
		// — the "All" chip is pinned there.)
		function updateFades(root) {
			var max = root.scrollWidth - root.clientWidth;
			if (max <= 0) {
				root.classList.add("no-scroll");
				root.classList.remove("scrolled", "at-end");
				return;
			}
			root.classList.remove("no-scroll");
			var atStart = root.scrollLeft <= 1;
			var atEnd = root.scrollLeft >= max - 1;
			root.classList.toggle("scrolled", !atStart && !atEnd);
			root.classList.toggle("at-end", !atStart && atEnd);
		}

		// Wire one filter root (idempotent — a root is never wired
		// twice, so re-running after a client-side navigation is
		// safe).
		function wire(root) {
			if (!root || root.getAttribute("data-filter-bound")) return;
			root.setAttribute("data-filter-bound", "");
			root.addEventListener(
				"scroll",
				function () {
					updateFades(root);
				},
				{ passive: true },
			);
			updateFades(root);
			// Initial state from the URL (?filter=). An unknown value
			// falls back to "all" and the bad param is dropped.
			var initial = readFilterFromUrl();
			var known =
				initial === "all" ||
				Array.prototype.some.call(
					root.querySelectorAll(".chip[data-filter]"),
					function (chip) {
						return (
							chip.getAttribute("data-filter") === initial
						);
					},
				);
			applyFilter(root, known ? initial : "all", {
				scroll: false,
				syncUrl: !known,
			});
		}

		function wireAll() {
			document
				.querySelectorAll("[data-archive-filter]")
				.forEach(wire);
		}

		// One delegated click handler for every filter chip on the
		// page, bound once on `document` — it survives client-side
		// navigation (language switch) without re-binding, the same
		// resilience pattern as the lightbox in detail.js.
		if (!window.__archiveFilterWired) {
			window.__archiveFilterWired = true;
			document.addEventListener("click", function (event) {
				var target = event.target;
				if (!(target instanceof HTMLElement)) return;
				var chip = target.closest(
					"[data-archive-filter] .chip[data-filter]",
				);
				if (!chip) return;
				var root = chip.closest("[data-archive-filter]");
				if (!root) return;
				applyFilter(
					root,
					chip.getAttribute("data-filter") || "all",
				);
			});
			document.addEventListener("astro:page-load", wireAll);
			window.addEventListener("resize", function () {
				document
					.querySelectorAll("[data-archive-filter]")
					.forEach(updateFades);
			});
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", wireAll);
		} else {
			wireAll();
		}
	})();
</script>
