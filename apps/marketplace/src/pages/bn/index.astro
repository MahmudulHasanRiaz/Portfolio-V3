---
import Layout from "../../layouts/Layout.astro";
import ThumbImage from "../../components/ThumbImage.astro";
import Hero from "../../components/Hero.astro";
import Stats from "../../components/Stats.astro";
import Services from "../../components/Services.astro";
import ProjectsCarousel from "../../components/ProjectsCarousel";
import StackGlobe from "../../components/StackGlobe";
import Combined from "../../components/Combined.astro";
import ClientsWall from "../../components/ClientsWall.astro";
import KnowMeSections from "../../components/KnowMeSections.astro";
import { getProjects, getCaseStudies, getPosts, getServices, getTechnologies, formatDate, readingTimeFromText, truncateShort } from "../../lib/content";
import { applySiteCopy, getDict, langUrl, localizeData, pickDict, PROJECTS_CAROUSEL_DICT_KEYS, STACK_GLOBE_DICT_KEYS, readingTimeLabel } from "../../lib/i18n";
import { getSiteSettings } from "../../lib/settings";
import { resolveCanonicalBase } from "../../lib/detail";
import {
	HOMEPAGE_CASE_STUDIES_LIMIT,
	HOMEPAGE_POSTS_LIMIT,
	HOMEPAGE_PROJECTS_LIMIT,
} from "../../lib/homepage-limits";
import { PROFILE } from "../../data/site";

// Bangla homepage — same sections as the English homepage, in Bangla.
// Content rows are localised per-item (bn overlay, English fallback);
// fixed strings come from the dictionary. No auto-redirect anywhere:
// the visitor is here because the URL is /bn/ (or the first-visit
// script / switcher sent them here).
const lang = "bn" as const;
const t = applySiteCopy(getDict(lang), lang, await getSiteSettings());

// Primary identity (admin setting, Wave 2 A1): when the default is
// "know-me", /bn/ BECOMES the Know Me page — it renders KnowMeSections
// directly, NOT a redirect to /bn/know-me (a redirect would split the
// canonical homepage and break the / SEO already built). /bn/know-me
// stays the permanent canonical URL for that content. When the default
// is Software Engineer, /bn/ renders exactly as before.

// Canonical site URL for the Person JSON-LD: admin setting
// (site_url) when set, else the live workers.dev base — never the
// old riaz.com.bd domain while the site lives on workers.dev.
// (Moved above the content fetches: the primary-identity branch
// below needs `settings` before deciding what to fetch.)
const settings = await getSiteSettings();
const siteUrl = resolveCanonicalBase(settings.siteUrl, Astro.url);

const isKnowMe = settings.primaryIdentity === "know-me";
const profile = isKnowMe ? "knowme" : "se";

// The SE branch needs these rows; the Know Me branch fetches its own
// rows inside KnowMeSections, so skip them there (no double fetch).
// Services are fetched in BOTH branches: the SE branch's Services
// section needs the live rows, and Layout accepts them as a prop.
// Technologies are fetched in both branches too (the globe reads
// them as a prop; the fetch falls back to build-time rows when the
// live API is unreachable).
const projectsRaw = isKnowMe ? [] : await getProjects();
const projects = projectsRaw.map((p) => ({
	...p,
	data: localizeData(p.data, lang),
}));
const caseStudiesRaw = isKnowMe ? [] : await getCaseStudies();
const caseStudies = caseStudiesRaw.map((cs) => ({
	...cs,
	data: localizeData(cs.data, lang),
}));
const postsRaw = isKnowMe ? [] : await getPosts();
const posts = postsRaw.map((p) => ({
	...p,
	data: localizeData(p.data, lang),
}));
const services = await getServices();
// Live stack techs over the build-time fallback; bn overlay per tech
// (name / use from the API `bn`, English fallback — `category` is
// never overlaid, filter state keys stay English).
const technologies = (await getTechnologies()).map((tech) =>
	localizeData({ ...tech }, lang),
);

const carouselProjects = projects.slice(0, HOMEPAGE_PROJECTS_LIMIT).map((p) => ({
	slug: p.data.slug,
	title: p.data.title,
	description: p.data.description ?? "",
	tags: p.data.tags ?? [],
	techs: p.data.techs ?? [],
	thumbnail: p.data.thumbnail ?? null,
	thumbnailType: p.data.thumbnailType ?? null,
	thumbnailAutoplay: p.data.thumbnailAutoplay ?? null,
}));

const personJsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: PROFILE.name,
	jobTitle: PROFILE.designations,
	url: `${siteUrl}/`,
	// MARKETPLACE COPY: no "email" field — no contact info on this copy.
	inLanguage: "bn",
	address: { "@type": "PostalAddress", addressLocality: "Dhaka", addressCountry: "BD" },
};
---

<Layout
	title={isKnowMe ? t.knowMeTitle : (settings.siteTitle ?? t.homeTitle)}
	description={isKnowMe ? t.knowMeDescription : t.homeDescription}
	profile={profile}
	lang={lang}
	services={services}
>
	{isKnowMe ? (
		<KnowMeSections lang={lang} />
	) : (
		<>
			<script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

	<Hero profile="se" lang={lang} />

	<Stats lang={lang} />

	<Services services={services} lang={lang} />

	<section class="glass section" id="projects">
		<div class="section-head">
			<div>
				<h2>{t.projectsTitle}</h2>
				<p>{t.projectsSub}</p>
			</div>
			<a class="view-all" href={langUrl("/projects", lang)}>{t.viewAllProjects}</a>
		</div>
		{/* client:idle (not client:visible): the island hydrates on idle
		    time after load, so the skeleton resolves to real cards
		    even if the visitor never scrolls — with client:visible
		    the section sat as a skeleton ("boro faka jayga") until
		    it entered the viewport. The skeleton footprint now
		    matches the real layout, so the swap has no jump. */}
		{projects.length === 0 ? (
			<p class="empty-state">{t.emptyProjects}</p>
		) : (
			<ProjectsCarousel projects={carouselProjects} lang={lang} dict={pickDict(t, PROJECTS_CAROUSEL_DICT_KEYS)} client:idle />
		)}
	</section>

	{
		caseStudies.length > 0 ? (
			<section class="glass section" id="case-studies">
				<div class="section-head">
					<div>
						<h2>{t.caseStudiesTitle}</h2>
						<p>{t.caseStudiesSub}</p>
					</div>
					<a class="view-all" href={langUrl("/case-studies", lang)}>
						{t.viewAllCaseStudies}
					</a>
				</div>
				<div class="card-grid">
					{caseStudies.slice(0, HOMEPAGE_CASE_STUDIES_LIMIT).map((cs) => (
						<a class="grid-card" data-astro-prefetch="hover" href={langUrl(`/case-studies/${cs.data.slug}`, lang)}>
							<div class="grid-thumb">
								{cs.data.thumbnailType === "video" && cs.data.thumbnail ? (
									<video
										src={cs.data.thumbnail}
										aria-label={cs.data.title}
										muted
										loop
										playsinline
										autoplay={cs.data.thumbnailAutoplay !== false}
										preload="metadata"
									/>
								) : cs.data.thumbnail ? (
									<ThumbImage
										src={cs.data.thumbnail}
										alt={cs.data.title}
										widths={[360, 720, 1080]}
										sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 360px"
										width={800}
										height={500}
									/>
								) : (
									<span class="thumb-fallback" aria-hidden="true">
										{cs.data.title.charAt(0)}
									</span>
								)}
							</div>
							<div class="grid-body">
								<h3>{cs.data.title}</h3>
								{cs.data.description ? <p>{truncateShort(cs.data.description)}</p> : null}
								<span class="service-cue">{t.readCaseStudy}
									<svg
										width="15"
										height="15"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<line x1="5" y1="12" x2="19" y2="12" />
										<polyline points="12 5 19 12 12 19" />
									</svg>
								</span>
							</div>
						</a>
					))}
				</div>
			</section>
		) : null
	}

	<StackGlobe lang={lang} dict={pickDict(t, STACK_GLOBE_DICT_KEYS)} techs={technologies} client:visible />

	<Combined lang={lang} />

	<ClientsWall lang={lang} />

	<section class="glass section" id="posts">
		<div class="section-head">
			<div>
				<h2>{t.latestPostsTitle}</h2>
				<p>{t.latestPostsSub}</p>
			</div>
			<a class="view-all" href={langUrl("/posts", lang)}>{t.viewAllPosts}</a>
		</div>
		{posts.length === 0 ? (
			<p class="empty-state">{t.emptyPosts}</p>
		) : (
			<div class="card-grid">
				{posts.slice(0, HOMEPAGE_POSTS_LIMIT).map((post) => {
					// Reading time is COMPUTED from the actual post text —
					// build-time markdown body first, live API `content`
					// second — never the stored value on its own.
					const postText =
						post.body ??
						(post.data as { content?: string }).content ??
						"";
					const readingTime =
						readingTimeFromText(postText) ??
						post.data.readingTime ??
						undefined;
					return (
						<a class="grid-card" data-astro-prefetch="hover" href={langUrl(`/posts/${post.data.slug}`, lang)}>
							<div class="grid-thumb">
								{post.data.thumbnailType === "video" && post.data.thumbnail ? (
									<video
										src={post.data.thumbnail}
										aria-label={post.data.title}
										muted
										loop
										playsinline
										autoplay={post.data.thumbnailAutoplay !== false}
										preload="metadata"
									/>
								) : post.data.thumbnail ? (
									<ThumbImage
										src={post.data.thumbnail}
										alt={post.data.title}
										widths={[360, 720, 1080]}
										sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 360px"
										width={800}
										height={500}
									/>
								) : (
									<span class="thumb-fallback" aria-hidden="true">
										{post.data.title.charAt(0)}
									</span>
								)}
							</div>
							<div class="grid-body">
								{post.data.tags?.[0] ? (
									<div class="tag-row">
										<span class="tag">{post.data.tags[0]}</span>
									</div>
								) : null}
								<h3>{post.data.title}</h3>
								<p class="grid-meta">
									{formatDate(post.data.publishedAt, lang)}
									{readingTime ? ` · ${readingTimeLabel(readingTime, lang)}` : ""}
								</p>
							</div>
						</a>
					);
				})}
			</div>
		)}
	</section>

	{/* MARKETPLACE COPY: the Contact section (ContactForm) was removed — the homepage ends with Latest posts. */}
		</>
	)}
</Layout>
