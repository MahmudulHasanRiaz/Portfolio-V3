{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-v3-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Service bindings to the public-facing site workers (2026-11-13).
  // The purgePublicCache side effect (lib/side-effects.ts) calls each
  // site worker's /api/cache/invalidate to purge the edge cache on
  // admin saves. A Worker CANNOT fetch another Worker's
  // `*.workers.dev` URL from inside the Worker (Cloudflare "error
  // code: 1042"), so the purge goes through these bindings instead of
  // over HTTPS — the binding stays the production path now that
  // the custom domain is connected (2026-11-28). The PUBLIC_SITE_URL
  // var is still kept as the local-dev / no-binding fallback. PR #21 added MARKETPLACE_SITE: the
  // marketplace has the same tag-cached pages and the same
  // stale-fallback risk, but it was never purged.
  "services": [
    { "binding": "PUBLIC_SITE", "service": "portfolio-v3-public" },
    { "binding": "MARKETPLACE_SITE", "service": "portfolio-v3-marketplace" }
  ],
  // Workers Cron Trigger (2026-11-13): the V2 stack ran its scheduler
  // sidecar every 5 minutes, calling both cron routes (publish +
  // workflows). This trigger replaces it — one `*/5 * * * *` tick,
  // and the `scheduled` handler in src/index.ts invokes both routes
  // internally (same handlers, same x-cron-secret gate). CRON_SECRET
  // is already set on this Worker (verified live: the cron routes
  // answer 401 without the header, not 500).
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // Better Auth baseURL — MUST be the browser-facing ADMIN origin, not
    // this worker's own URL. The OAuth redirect_uri is built from it
    // ({baseURL}/api/auth/callback/<provider>), and the whole OAuth
    // round-trip must stay on the admin origin: the state cookie set by
    // /sign-in/social and the session cookie set by the callback land
    // on the admin origin through the admin's /api/* proxy, and the
    // browser is redirected back to the admin afterwards. With this
    // worker's URL here, the callback would land on the API worker,
    // the cookies would be set for the API origin (which the admin
    // never sees), and social sign-in could never complete. Email /
    // password sign-in is unaffected by this value (it is same-origin
    // through the proxy either way), as are the portal's internal
    // sign-up delegations (no redirects involved).
    "BETTER_AUTH_URL": "https://admin.mahmudulhasanriaz.com",
    // Public r2.dev URL of the portfolio-v3-media R2 bucket. The PDF
    // routes (finance invoices, proposal documents) store generated
    // PDFs under documents/ and return { pdfUrl } built from this
    // base; without it they fall back to "<bucket>/documents/<file>",
    // which is not directly openable. Public URL, not a secret.
    "R2_PUBLIC_URL": "https://pub-d9ea4c7692ee4f9994115a16899922b0.r2.dev"
  }
}
