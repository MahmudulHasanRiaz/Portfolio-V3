---
// Twin SSR fallback — case-study detail template.
//
// The SAME markup as the static case-study detail page
// (src/pages/case-studies/[slug].astro), driven by the view model
// built in src/lib/twin-detail.ts from the LIVE row only (a twin slug
// is never in the build-time collections, so there is no markdown
// body — the lede comes from the live `content` string). The static
// page is the source of truth — keep this in sync with it.
import DetailCta from "../DetailCta.astro";
import DetailMedia from "../DetailMedia.astro";
import DetailVideoFacade from "../DetailVideoFacade.astro";
import KeyStrip from "../KeyStrip.astro";
import MarkdownBody from "../MarkdownBody.astro";
import PrevNext from "../PrevNext.astro";
import TechChips from "../TechChips.astro";
import { formatDate } from "../../lib/content";
import { langUrl, type Dict, type Lang } from "../../lib/i18n";
import { optimizedImageUrl, optimizedSrcset } from "../../lib/images";
import type { CaseStudyView } from "../../lib/twin-detail";

interface Props {
	view: CaseStudyView;
	lang: Lang;
	t: Dict;
}

const { view, lang, t } = Astro.props;
const d = view.d;
---

{
	view.found && d ? (
		<section class="glass">
			{view.jsonLd && (
				<script
					type="application/ld+json"
					set:html={JSON.stringify(view.jsonLd)}
				/>
			)}

			<a class="back-link" href={langUrl("/case-studies", lang)}>
				{t.backAllCaseStudies}
			</a>
			{d.thumbnail &&
				(view.isVideoThumb && view.videoSrc ? (
					<div class="detail-hero">
						<DetailVideoFacade
							src={view.videoSrc}
							poster={view.videoPoster}
							title={d.title}
							lang={lang}
							dict={t}
						/>
					</div>
				) : (
					<div class="detail-hero">
						<img
							src={optimizedImageUrl(d.thumbnail, 1200)}
							alt={d.title}
							fetchpriority="high"
							decoding="async"
							srcset={d.thumbnail?.includes("images.unsplash.com") ? `${d.thumbnail.replace(/w=\d+/, "w=800").replace(/q=\d+/, "q=75")} 800w, ${d.thumbnail.replace(/q=\d+/, "q=75")} 1200w` : optimizedSrcset(d.thumbnail, [800, 1200])}
							sizes="(max-width: 640px) 100vw, 1088px"
						/>
					</div>
				))}
			<h1 class="detail-title">{d.title}</h1>
			{d.tags?.length ? (
				<div class="tag-row" style="margin-top:12px;">
					{d.tags.map((tag) => (
						<span class="tag">{tag}</span>
					))}
				</div>
			) : null}
			<KeyStrip
				items={[
					{
						label: t.publishedLabel,
						value: formatDate(d.publishedAt, lang),
					},
					d.tags?.length
						? { label: t.categoryLabel, value: d.tags.join(", ") }
						: null,
					d.projectSlug
						? {
								label: t.projectLabel,
								value: t.viewProject,
								href: langUrl(`/projects/${d.projectSlug}`, lang),
							}
						: null,
				]}
			/>
			{view.ledeBlocks.length > 0 ? (
				<MarkdownBody blocks={view.ledeBlocks} />
			) : null}
			{(d.problem || d.fix || d.result) && (
				<div class="problem-fix-result">
					{d.problem && (
						<div class="pfr">
							<h3>{t.problem}</h3>
							<p>{d.problem}</p>
						</div>
					)}
					{d.fix && (
						<div class="pfr">
							<h3>{t.fix}</h3>
							<p>{d.fix}</p>
							{d.fixPoints?.length ? (
								<ul class="fix-points">
									{d.fixPoints.map((point) => (
										<li>{point}</li>
									))}
								</ul>
							) : null}
						</div>
					)}
					{d.result && (
						<div class="pfr">
							<h3>{t.result}</h3>
							<p>{d.result}</p>
						</div>
					)}
				</div>
			)}
			{d.metrics?.length ? (
				<div class="metrics-band" aria-label={t.result}>
					{d.metrics.map((metric) => (
						<div class="metric-card">
							<strong>{metric.value}</strong>
							<span>{metric.label}</span>
						</div>
					))}
				</div>
			) : null}
			{d.research ? (
				<section class="detail-section" aria-label={t.research}>
					<h2 class="detail-h2">{t.research}</h2>
					<MarkdownBody text={d.research} />
				</section>
			) : null}
			<TechChips techs={view.techs} lang={lang} dict={t} />
			<DetailMedia
				lang={lang}
				dict={t}
				gallery={d.gallery ?? []}
				videos={d.videos ?? []}
				exclude={d.thumbnail}
				altBase={`${d.title} ${t.galleryImage}`}
			/>
			<DetailCta
				title={t.facingSimilar}
				text={t.caseStudyCtaText}
				buttonLabel={t.discussSimilarProject}
				linkHref={
					d.projectSlug
						? langUrl(`/projects/${d.projectSlug}?from=case-study:${view.slug}`, lang)
						: undefined
				}
				linkLabel={d.projectSlug ? t.viewProject : undefined}
				source="case-study-detail"
				lang={lang}
				dict={t}
			/>
			<PrevNext prev={view.prev} next={view.next} lang={lang} dict={t} />
		</section>
	) : (
		<section class="glass">
			<a class="back-link" href={langUrl("/case-studies", lang)}>
				{t.backAllCaseStudies}
			</a>
			<h1 class="detail-title">{t.notFoundCaseStudy}</h1>
			<p class="empty-state">{t.notPublishedCaseStudy}</p>
		</section>
	)
}
