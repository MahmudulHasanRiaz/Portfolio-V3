---
// ArchiveFilter — ONE shared filter control for every archive page
// (projects, posts, ventures, releases — EN + BN).
//
// WHY IT EXISTS (2026-11-12): every archive used to render ALL of its
// tags as chips in one wrapping row. /projects/ had 18 chips over 6 rows
// on mobile — a jungle that only gets worse as categories grow. This
// component caps the visible row and puts the rest behind a "More" menu:
//
//   - "All" + the top 5 options by item count (ties: alphabetical) as
//     chips. 6 or fewer options total: all of them as chips, no menu.
//   - A "More" button (+N = how many more exist) opening a dropdown
//     with EVERY option, alphabetical, each with its item count.
//   - The active filter is always visible: a primary chip goes .active,
//     or — when the selection lives only in the menu — the "More" button
//     itself shows the selected label and goes .active.
//
// Filtering is still client-side, no framework, one tiny inline script:
// cards are matched per `mode` — "card-tag-text" (projects: a .tag
// descendant's text), "card-data-tags" (posts/ventures: the card's
// data-tags CSV), "card-data-type" (releases: the card's data-type).
// No URL state, same as before. Counts are computed by the page from
// the same data it already renders and passed in as `items`.
interface FilterItem {
	value: string;
	label: string;
	count: number;
}

interface Props {
	items: FilterItem[];
	allLabel: string;
	moreLabel: string;
	mode: "card-tag-text" | "card-data-tags" | "card-data-type";
	gridSelector: string;
	countSelector: string;
	cardSelector: string;
	id?: string;
	style?: string;
}

const {
	items,
	allLabel,
	moreLabel,
	mode,
	gridSelector,
	countSelector,
	cardSelector,
	id,
	style,
} = Astro.props;

// 6 or fewer options: show them all, no menu. Above that, 5 primary
// chips + the menu (which lists every option, so nothing is reachable
// only through a hidden chip).
const SHOW_ALL_UP_TO = 6;
const PRIMARY_COUNT = 5;
const showAll = items.length <= SHOW_ALL_UP_TO;
const primary = showAll
	? items
	: [...items]
			.sort(
				(a, b) => b.count - a.count || a.label.localeCompare(b.label),
			)
			.slice(0, PRIMARY_COUNT);
const menuItems = [...items].sort((a, b) =>
	a.label.localeCompare(b.label),
);
const overflowCount = items.length - primary.length;
---

<div
	class="chip-row"
	id={id}
	style={style}
	data-archive-filter
	data-mode={mode}
	data-grid={gridSelector}
	data-count={countSelector}
	data-card={cardSelector}
>
	<button
		type="button"
		class="chip active"
		data-filter="all"
		aria-pressed="true"
	>
		{allLabel}
	</button>
	{
		primary.map((item) => (
			<button
				type="button"
				class="chip"
				data-filter={item.value}
				aria-pressed="false"
			>
				{item.label}
			</button>
		))
	}
	{
		!showAll && (
			<span class="filter-more-wrap" data-filter-more-wrap>
				<button
					type="button"
					class="chip filter-more"
					data-filter-more
					aria-haspopup="true"
					aria-expanded="false"
				>
					<span data-filter-more-label>{moreLabel}</span>{" "}
					<span class="filter-more-n" data-filter-more-n>
						+{overflowCount}
					</span>
					<span class="filter-caret" aria-hidden="true">
						▾
					</span>
				</button>
				<span
					class="filter-menu"
					role="menu"
					data-filter-menu
					aria-label={moreLabel}
				>
					{menuItems.map((item) => (
						<button
							type="button"
							class="filter-menu-item"
							role="menuitemradio"
							aria-checked="false"
							data-filter={item.value}
						>
							<span class="filter-menu-check" aria-hidden="true">
								✓
							</span>
							<span class="filter-menu-label">{item.label}</span>
							<span class="filter-menu-count">{item.count}</span>
						</button>
					))}
				</span>
			</span>
		)
	}
</div>

<script is:inline>
	// Archive filter (shared ArchiveFilter.astro): chips + "More" menu
	// toggle cards by the page's matching mode. No framework.
	(function () {
		function init() {
			var root = document.querySelector("[data-archive-filter]");
			if (!root) return;
			var mode = root.getAttribute("data-mode");
			var grid = document.querySelector(root.getAttribute("data-grid"));
			if (!grid) return;
			var cardSel = root.getAttribute("data-card") || ".grid-card";
			var cards = Array.prototype.slice.call(
				grid.querySelectorAll(cardSel),
			);
			var countEl = document.querySelector(
				root.getAttribute("data-count"),
			);
			var total = cards.length;
			var template = countEl
				? countEl.getAttribute("data-count-template") || ""
				: "";
			var fmt = function (n) {
				return template.indexOf("টি") !== -1
					? n.toLocaleString("bn-BD")
					: String(n);
			};
			var moreWrap = root.querySelector("[data-filter-more-wrap]");
			var moreBtn = root.querySelector("[data-filter-more]");
			var moreLabelEl = moreBtn
				? moreBtn.querySelector("[data-filter-more-label]")
				: null;
			var moreN = moreBtn
				? moreBtn.querySelector("[data-filter-more-n]")
				: null;
			var menu = root.querySelector("[data-filter-menu]");
			var defaultMoreLabel = moreLabelEl
				? moreLabelEl.textContent
				: "";

			function matches(card, value) {
				if (value === "all") return true;
				if (mode === "card-data-tags") {
					var tags = (card.getAttribute("data-tags") || "")
						.split(",")
						.map(function (s) {
							return s.trim();
						});
					return tags.indexOf(value) !== -1;
				}
				if (mode === "card-data-type") {
					return card.getAttribute("data-type") === value;
				}
				// card-tag-text (projects): a .tag descendant's text.
				var tagEls = card.querySelectorAll(".tag");
				for (var i = 0; i < tagEls.length; i++) {
					if ((tagEls[i].textContent || "").trim() === value)
						return true;
				}
				return false;
			}

			function menuLabelFor(value) {
				if (!menu) return "";
				var safe = value
					.replace(/\\/g, "\\\\")
					.replace(/"/g, '\\"');
				var item = menu.querySelector(
					'[data-filter="' + safe + '"] .filter-menu-label',
				);
				return item ? item.textContent || "" : "";
			}

			function apply(value) {
				var shown = 0;
				cards.forEach(function (card) {
					var show = matches(card, value);
					card.style.display = show ? "" : "none";
					if (show) shown++;
				});
				// Primary chips (incl. All).
				var primaryActive = false;
				root.querySelectorAll(".chip[data-filter]").forEach(
					function (chip) {
						var active =
							chip.getAttribute("data-filter") === value;
						chip.classList.toggle("active", active);
						chip.setAttribute(
							"aria-pressed",
							active ? "true" : "false",
						);
						if (active) primaryActive = true;
					},
				);
				// Menu items.
				if (menu) {
					menu.querySelectorAll(
						".filter-menu-item",
					).forEach(function (item) {
						item.setAttribute(
							"aria-checked",
							item.getAttribute("data-filter") === value
								? "true"
								: "false",
						);
					});
				}
				// The "More" button shows the selection when it lives
				// only in the menu; otherwise it stays "More +N".
				if (moreBtn && moreLabelEl) {
					if (value === "all" || primaryActive) {
						moreLabelEl.textContent = defaultMoreLabel;
						if (moreN) moreN.style.display = "";
						moreBtn.classList.remove("active");
						moreBtn.setAttribute("aria-pressed", "false");
					} else {
						moreLabelEl.textContent = menuLabelFor(value);
						if (moreN) moreN.style.display = "none";
						moreBtn.classList.add("active");
						moreBtn.setAttribute("aria-pressed", "true");
					}
				}
				if (countEl) {
					countEl.textContent = template
						? template
								.replace("{shown}", fmt(shown))
								.replace("{total}", fmt(total))
						: "Showing " + shown + " of " + total;
				}
			}

			function setOpen(open, focusItem) {
				if (!moreWrap || !moreBtn || !menu) return;
				moreWrap.classList.toggle("open", open);
				moreBtn.setAttribute(
					"aria-expanded",
					open ? "true" : "false",
				);
				if (open && focusItem) {
					var items = menu.querySelectorAll(
						".filter-menu-item",
					);
					var checked = menu.querySelector(
						'.filter-menu-item[aria-checked="true"]',
					);
					(checked || items[0]).focus();
				}
			}

			function isOpen() {
				return !!(
					moreWrap && moreWrap.classList.contains("open")
				);
			}

			// One delegated click handler: chips, menu items, More btn.
			root.addEventListener("click", function (event) {
				var target = event.target;
				if (!(target instanceof HTMLElement)) return;
				if (moreBtn && target.closest("[data-filter-more]")) {
					setOpen(!isOpen(), true);
					return;
				}
				var option = target.closest("[data-filter]");
				if (!option) return;
				apply(option.getAttribute("data-filter") || "all");
				if (isOpen()) setOpen(false, false);
			});

			// Close the menu on outside click / Escape; arrow keys move
			// between menu items.
			document.addEventListener("click", function (event) {
				if (!isOpen()) return;
				var target = event.target;
				if (
					target instanceof Node &&
					moreWrap &&
					!moreWrap.contains(target)
				) {
					setOpen(false, false);
				}
			});
			document.addEventListener("keydown", function (event) {
				if (!isOpen()) return;
				if (event.key === "Escape") {
					setOpen(false, false);
					if (moreBtn) moreBtn.focus();
					return;
				}
				if (!menu) return;
				var items = Array.prototype.slice.call(
					menu.querySelectorAll(".filter-menu-item"),
				);
				var idx = items.indexOf(document.activeElement);
				if (event.key === "ArrowDown") {
					event.preventDefault();
					(items[idx + 1] || items[0]).focus();
				} else if (event.key === "ArrowUp") {
					event.preventDefault();
					(items[idx - 1] || items[items.length - 1]).focus();
				} else if (event.key === "Home") {
					event.preventDefault();
					items[0].focus();
				} else if (event.key === "End") {
					event.preventDefault();
					items[items.length - 1].focus();
				}
			});
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", init);
		} else {
			init();
		}
	})();
</script>
