---
import Layout from "../../layouts/Layout.astro";
import BrandIcon from "../../components/BrandIcon.astro";
import ArchiveFilter from "../../components/ArchiveFilter.astro";
import { WIKIMEDIA_LOGOS } from "../../data/site";
import { getReleases } from "../../lib/content";
import { youtubeThumb } from "../../lib/youtube";
import { getDict, langUrl, showingLabel } from "../../lib/i18n";

// Releases archive — fixed strings from the dictionary (same keys as
// the /bn/ archive). Type labels come from the dict, never hardcoded.
const lang = "en" as const;
const t = getDict(lang);

const releases = await getReleases();

// Filter chips by release type — only types that exist.
const typeLabels: Record<string, string> = {
	nasheed: t.releaseTypeNasheed,
	tilawat: t.releaseTypeTilawat,
	podcast: t.releaseTypePodcast,
	lecture: t.releaseTypeLecture,
	other: t.releaseTypeOther,
};
const presentTypes = [
	...new Set(
		releases.map((r) => (r.data.releaseType ?? "other").toLowerCase()),
	),
].sort();

// Per-type counts for the shared archive filter (ArchiveFilter.astro).
const filterItems = presentTypes.map((type) => ({
	value: type,
	label: typeLabels[type] ?? type,
	count: releases.filter(
		(r) => (r.data.releaseType ?? "other").toLowerCase() === type,
	).length,
}));

const RELEASE_PLATFORM_ICONS: Record<string, string> = {
	YouTube: "youtube",
	Spotify: "spotify",
	"Apple Music": "applemusic",
	Deezer: "deezer",
	Boomplay: `wikimedia:${WIKIMEDIA_LOGOS.boomplay}`,
	JioSaavn: `wikimedia:${WIKIMEDIA_LOGOS.jiosaavn}`,
	SoundCloud: "soundcloud",
};

// The DB seed used 2021-01-01 as a placeholder date for the four
// audio-only singles — omit it rather than display it as fact until
// the real Spotify release dates are known.
const PLACEHOLDER_DATE = "2021-01-01";

function releaseYear(publishedAt?: string): string {
	if (!publishedAt || publishedAt.startsWith(PLACEHOLDER_DATE)) return "";
	return publishedAt.slice(0, 4);
}
---

<Layout
	title={t.releasesPageTitle}
	description={t.releasesPageDescription}
	lang={lang}
>
	<p>
		<a href={langUrl("/", lang)} class="back-link">{t.backHome}</a>
	</p>
	<h1 style="margin:0 0 8px;font-size:26px;line-height:1.25;">{t.allReleases}</h1>

	{
		releases.length === 0 ? (
			<section class="glass section">
				<p class="empty-state">{t.emptyReleases}</p>
			</section>
		) : (
			<>
				{filterItems.length > 0 ? (
					<ArchiveFilter
						id="release-filters"
						style="margin-top:16px;"
						items={filterItems}
						allLabel={t.allChip}
						mode="card-data-type"
						gridSelector="#release-list"
						countSelector="#release-count"
						cardSelector=".release-card"
					/>
				) : null}
				<p class="count-line" id="release-count" data-count-template={t.showingReleases}>
					{showingLabel(t.showingReleases, releases.length, releases.length)}
				</p>
				<!-- Same card grid as the Know Me releases section (preview):
				     aspect-video thumbnail + title, type · year, platform
				     icons opposite the title, audio pill for audio-only.
				     No description in the card — it lives on the detail page. -->
				<ul class="release-grid" id="release-list">
					{releases.map((release) => {
						const type = (
							release.data.releaseType ?? "other"
						).toLowerCase();
						const hasYouTube = release.data.platforms.some(
							(p) => p.name === "YouTube",
						);
						const thumb = release.data.youtubeId
							? youtubeThumb(release.data.youtubeId)
							: null;
						const shownPlatforms = release.data.platforms.slice(0, 6);
						const extra =
							release.data.platforms.length - shownPlatforms.length;
						const year = releaseYear(release.data.publishedAt);
						const typeLabel = typeLabels[type] ?? type;
						const meta = [typeLabel, year]
							.filter(Boolean)
							.join(" · ");
						return (
							<li class="release-card" data-type={type}>
								<a
									class="release-card-link"
									href={langUrl(`/releases/${release.data.slug}`, lang)}
									data-astro-prefetch="hover"
									aria-label={`${t.viewDetailsFor} ${release.data.title}`}
								>
									<span class="release-card-thumb">
										{thumb ? (
											<>
												<img
													src={thumb}
													alt={release.data.title}
													width="480"
													height="360"
													loading="lazy"
													decoding="async"
												/>
												<span
													class="release-play"
													aria-hidden="true"
												>
													<svg
														width="18"
														height="18"
														viewBox="0 0 24 24"
														fill="currentColor"
														aria-hidden="true"
													>
														<path d="M8 5.5v13l11-6.5z" />
													</svg>
												</span>
											</>
										) : (
											<span
												class="release-audio-tile"
												aria-hidden="true"
											>
												<BrandIcon
													icon="spotify"
													name="Spotify"
													size={52}
													decorative
												/>
											</span>
										)}
									</span>
									<span class="release-card-body">
										<span class="release-card-top">
											<span class="release-card-title">
												<span class="release-title">
													{release.data.title}
												</span>
												{meta ? (
													<span class="release-meta">
														{meta}
													</span>
												) : null}
											</span>
											<span
												class="release-card-platforms"
												aria-label={`${t.availableOn} ${release.data.platforms.map((p) => p.name).join(", ")}`}
											>
												{shownPlatforms.map((p) => {
													const icon =
														RELEASE_PLATFORM_ICONS[p.name];
													return icon ? (
														<BrandIcon
															icon={icon}
															name={p.name}
															size={20}
															decorative
														/>
													) : null;
												})}
												{extra > 0 ? (
													<span class="plat-more">
														+{extra}
													</span>
												) : null}
											</span>
										</span>
										{!hasYouTube ? (
											<span class="audio-badge">
												<svg
													width="12"
													height="12"
													viewBox="0 0 24 24"
													fill="none"
													stroke="currentColor"
													stroke-width="2.4"
													stroke-linecap="round"
													aria-hidden="true"
												>
													<path d="M9 18V5l12-2v13" />
													<circle cx="6" cy="18" r="3" />
													<circle cx="18" cy="16" r="3" />
												</svg>
												{t.audioOnly}
											</span>
										) : null}
									</span>
								</a>
							</li>
						);
					})}
				</ul>
			</>
		)
	}
</Layout>

