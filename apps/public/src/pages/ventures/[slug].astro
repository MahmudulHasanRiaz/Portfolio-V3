---
import Layout from "../../layouts/Layout.astro";
import DetailCta from "../../components/DetailCta.astro";
import DetailMedia from "../../components/DetailMedia.astro";
import DetailVideoFacade from "../../components/DetailVideoFacade.astro";
import KeyStrip from "../../components/KeyStrip.astro";
import MarkdownBody from "../../components/MarkdownBody.astro";
import PrevNext from "../../components/PrevNext.astro";
import { getEntry, getLiveEntry } from "astro:content";
import {
	liveCollectionReachable,
} from "../../loaders/public-content";
import { getVentures, formatDate } from "../../lib/content";
import {
	resolveCanonicalBase,
	absUrl,
	dedupeBlocks,
	isRealUrl,
	mergeDetail,
	parseBodyBlocks,
} from "../../lib/detail";
import { optimizedImageUrl, optimizedSrcset } from "../../lib/images";
import { PROFILE } from "../../data/site";
import { applySiteCopy, getDict, langUrl } from "../../lib/i18n";
import { getSiteSettings } from "../../lib/settings";

// Live detail route — on-demand SSR (2026-11-12, output "server"):
// every request renders this page in the Worker from the Public
// Content API. When the API is reachable the live entry is
// authoritative (a missing live entry 404s); the build-time row is
// only the outage fallback when the API is unreachable (fix plan §1b).
// A slug published after a deploy shows instantly — no rebuild.
// Route caching is in astro.config.mjs + src/middleware.ts.
const lang = "en" as const;
const settings = await getSiteSettings();
const t = applySiteCopy(getDict(lang), lang, settings);

const { slug } = Astro.params;
if (!slug) Astro.response.status = 404;

const liveResult = slug
	? await getLiveEntry("liveVentures", slug).catch(() => undefined)
	: undefined;
const liveEntry = liveResult?.entry;
if (liveEntry) Astro.cache.set(liveEntry);
// When the live API is reachable, the live entry is authoritative:
	// a missing live entry 404s and the build-time row is never read,
	// so an archived/draft item cannot render from its static file.
	// When unreachable, the build-time row is the outage fallback and
	// mergeDetail() below still fills gaps in the live row.
	const liveReachable = await liveCollectionReachable("ventures");
	const buildEntry =
		liveReachable || !slug
			? undefined
			: await getEntry("ventures", slug);
const entry = liveEntry ?? buildEntry;
if (!entry) Astro.response.status = 404;

interface Metric {
	value: string;
	label: string;
}

interface VentureData {
	title?: string;
	description?: string;
	content?: string;
	tags?: string[];
	publishedAt?: string;
	thumbnail?: string;
	thumbnailType?: "image" | "video";
	thumbnailVideoUrl?: string;
	website?: string | null;
	gallery?: string[];
	videos?: Array<{ url: string; title?: string }>;
	stage?: string;
	location?: string;
	teamSize?: string;
	foundedDate?: string;
	foundedYear?: number;
	metrics?: Metric[];
}

const liveData = liveEntry?.data as unknown as
	| Record<string, unknown>
	| undefined;
const buildData = buildEntry?.data as unknown as
	| Record<string, unknown>
	| undefined;
const data = mergeDetail(buildData, liveData) as unknown as
	| VentureData
	| undefined;

// The body is the long description — never the one-liner repeated: any
// paragraph that restates the description is dropped (the live
// duplication bug — the same line rendered as subtitle AND as body).
const rawBody = data?.content ?? buildEntry?.body ?? "";
const bodyBlocks = dedupeBlocks(parseBodyBlocks(rawBody), [
	data?.description,
]);

const ventures = await getVentures();
const idx = slug ? ventures.findIndex((v) => v.data.slug === slug) : -1;
const prev = idx > 0 ? ventures[idx - 1] : undefined;
const next =
	idx >= 0 && idx < ventures.length - 1 ? ventures[idx + 1] : undefined;
const thumbOf = (v: (typeof ventures)[number] | undefined) =>
	v?.data.thumbnailType !== "video" && v?.data.thumbnail
		? v.data.thumbnail
		: null;

const title = data?.title ?? t.notFoundVenture;
const description = data?.description;
const tags = data?.tags ?? [];
const website = isRealUrl(data?.website) ? data.website : null;

const isVideoThumb = data?.thumbnailType === "video";
const videoSrc = isVideoThumb
	? (data?.thumbnailVideoUrl ?? data?.thumbnail)
	: undefined;
const videoPoster =
	isVideoThumb &&
	data?.thumbnailVideoUrl &&
	data?.thumbnail &&
	data.thumbnail !== data.thumbnailVideoUrl &&
	!/\.(mp4|webm|mov|m4v)([?#]|$)/i.test(data.thumbnail)
		? data.thumbnail
		: null;
const coverImage =
	!isVideoThumb && data?.thumbnail ? data.thumbnail : videoPoster;

// Canonical base: explicit admin site_url wins; else the request
// host (Astro.url), else the SITE_URL fallback — see detail.ts.
const siteBase = resolveCanonicalBase(settings.siteUrl, Astro.url);
const pageUrl = `${siteBase}/ventures/${slug}`;
const jsonLd = data
	? {
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "Organization",
					name: title,
					...(description ? { description } : {}),
					inLanguage: "en",
					...(website ? { url: website } : {}),
					founder: { "@type": "Person", name: PROFILE.name },
				},
				{
					"@type": "BreadcrumbList",
					itemListElement: [
						{
							"@type": "ListItem",
							position: 1,
							name: "Home",
							item: siteBase,
						},
						{
							"@type": "ListItem",
							position: 2,
							name: t.allVentures,
							item: `${siteBase}/ventures`,
						},
						{
							"@type": "ListItem",
							position: 3,
							name: title,
							item: pageUrl,
						},
					],
				},
			],
		}
	: null;
---

<Layout
	title={`${title} — Mahmudul Hasan Riaz`}
	description={description}
	ogType="website"
	ogImage={coverImage ? absUrl(optimizedImageUrl(coverImage, 1200), siteBase) : null}
	canonical={pageUrl}
	lang={lang}
>
	{!entry || !data ? (
		<section class="glass">
			<a class="back-link" href={langUrl("/ventures", lang)}>
				{t.backAllVentures}
			</a>
			<h1 class="detail-title">{t.notFoundVenture}</h1>
			<p class="empty-state">{t.notPublishedVenture}</p>
		</section>
	) : (
		<section class="glass">
			{jsonLd ? (
				<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
			) : null}

			<a href={langUrl("/ventures", lang)} class="back-link">
				{t.backAllVentures}
			</a>

			{data.thumbnail &&
				(isVideoThumb && videoSrc ? (
					<div class="detail-hero">
						<DetailVideoFacade
							src={videoSrc}
							poster={videoPoster}
							title={title}
							lang={lang}
							dict={t}
						/>
					</div>
				) : (
					<div class="detail-hero">
						<img
							src={optimizedImageUrl(data.thumbnail, 1200)}
							alt={title}
							fetchpriority="high"
							decoding="async"
							srcset={data.thumbnail?.includes("images.unsplash.com") ? `${data.thumbnail.replace(/w=\d+/, "w=800").replace(/q=\d+/, "q=75")} 800w, ${data.thumbnail.replace(/q=\d+/, "q=75")} 1200w` : optimizedSrcset(data.thumbnail, [800, 1200])}
							sizes="(max-width: 640px) 100vw, 1088px"
						/>
					</div>
				))}
			<h1 class="detail-title">{title}</h1>
			{tags.length ? (
				<div class="tag-row" style="margin-top:12px;">
					{tags.map((tag) => (
						<span class="tag">{tag}</span>
					))}
				</div>
			) : null}
			{description ? <p class="detail-lede">{description}</p> : null}

			<KeyStrip
				items={[
					{
						label: t.publishedLabel,
						value: formatDate(data.publishedAt, lang),
					},
					data.stage ? { label: t.stageLabel, value: data.stage } : null,
					data.location
						? { label: t.locationLabel, value: data.location }
						: null,
					data.teamSize
						? { label: t.teamSizeLabel, value: data.teamSize }
						: null,
					data.foundedYear
						? {
								label: t.foundedLabel,
								value: String(data.foundedYear),
							}
						: data.foundedDate
							? {
									label: t.foundedLabel,
									value: formatDate(data.foundedDate, lang),
								}
							: null,
					tags.length
						? { label: t.categoryLabel, value: tags.join(", ") }
						: null,
					website
						? { label: t.websiteLabel, value: t.visitWebsite, href: website }
						: null,
				]}
			/>

			{data.metrics?.length ? (
				<div class="metrics-band" aria-label={t.ventureMetrics}>
					{data.metrics.map((metric) => (
						<div class="metric-card">
							<strong>{metric.value}</strong>
							<span>{metric.label}</span>
						</div>
					))}
				</div>
			) : null}

			{bodyBlocks.length > 0 ? (
				<section class="detail-section" aria-label={`${t.aboutVenture} ${title}`}>
					<h2 class="detail-h2">{t.aboutVenture} {title}</h2>
					<MarkdownBody blocks={bodyBlocks} />
				</section>
			) : null}

			<DetailMedia
				lang={lang}
				dict={t}
				gallery={data.gallery ?? []}
				videos={data.videos ?? []}
				exclude={data.thumbnail}
				altBase={`${title} ${t.galleryImage}`}
			/>

			<DetailCta
				title={`${t.thinkingVenture} ${title}?`}
				text={t.ventureCtaText}
				buttonLabel={t.discussSimilarVenture}
				source="venture-detail"
				lang={lang}
				dict={t}
			/>

			<PrevNext
				prev={
					prev
						? {
								href: langUrl(`/ventures/${prev.data.slug}`, lang),
								title: prev.data.title,
								thumb: thumbOf(prev),
							}
						: null
				}
				next={
					next
						? {
								href: langUrl(`/ventures/${next.data.slug}`, lang),
								title: next.data.title,
								thumb: thumbOf(next),
							}
						: null
				}
				lang={lang}
				dict={t}
			/>
		</section>
	)}
</Layout>
