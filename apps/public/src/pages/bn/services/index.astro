---
import Layout from "../../../layouts/Layout.astro";
import ServiceCards from "../../../components/ServiceCards.astro";
import { getServices } from "../../../lib/content";
import { applySiteCopy, getDict, langUrl } from "../../../lib/i18n";
import { getSiteSettings } from "../../../lib/settings";

// Bangla services archive — no filters: services have no tags or
// detail pages, so this is a plain listing of every service
// (getServices(), live over build-time), reusing the homepage
// Services card + modal pattern (ServiceCards.astro). Fixed strings
// from the dictionary (same keys as the /en/ archive).
const lang = "bn" as const;
const t = applySiteCopy(getDict(lang), lang, await getSiteSettings());

const services = await getServices();
---

<Layout
	title={t.servicesPageTitle}
	description={t.servicesPageDescription}
	lang={lang}
>
	<section class="glass archive-panel">
		<p style="margin:0 0 8px;">
			<a class="back-link" href={langUrl("/", lang)}>{t.backHome}</a>
		</p>
		<h1 style="margin:0 0 16px;font-size:24px;line-height:1.25;">{t.allServices}</h1>
		{
			services.length === 0 ? (
				<p class="empty-state">{t.emptyServices}</p>
			) : (
				<ServiceCards services={services} lang={lang} />
			)
		}
	</section>
</Layout>
