---
import Layout from "../layouts/Layout.astro";
import BrandIcon from "../components/BrandIcon.astro";
import StackGlobe from "../components/StackGlobe";
import { getTechnologies } from "../lib/content";
import { STACK_CATEGORIES, type StackTech } from "../data/site";
import {
	applySiteCopy,
	getDict,
	langUrl,
	pickDict,
	STACK_GLOBE_DICT_KEYS,
} from "../lib/i18n";
import { getSiteSettings } from "../lib/settings";

// Skills page (0039, PR #22; globe-first redesign PR #28) — the
// icon-only globe is the hero on top (StackGlobe `iconOnly`), then
// the software skills grouped by category, then the journey: PAST
// stages only (Graphic Design → Digital Marketing), ending in a
// "Today" node that points back up to the detailed skills above as
// the last step — NO separate Software Development stage, NO tech
// lists in the journey (PR #22's wholesale repeat was the user's
// "osundor" complaint). The journey section is hidden entirely
// while no past-stage skill exists. A proficiency bar renders ONLY
// when the admin set one — never invented. Hidden skills
// (is_visible = false) never render.
const lang = "en" as const;
const t = applySiteCopy(getDict(lang), lang, await getSiteSettings());

const visible = (await getTechnologies()).filter(
	(tech) => tech.isVisible !== false,
);
const software = visible.filter(
	(tech) => (tech.journeyStage ?? "software") === "software",
);

// Main section: group software skills by category, in the site's
// canonical category order; any other category sorts last,
// alphabetically.
const byCategory = new Map<string, StackTech[]>();
for (const tech of software) {
	const list = byCategory.get(tech.category) ?? [];
	list.push(tech);
	byCategory.set(tech.category, list);
}
const categories = [...byCategory.keys()].sort((a, b) => {
	const ia = (STACK_CATEGORIES as readonly string[]).indexOf(a);
	const ib = (STACK_CATEGORIES as readonly string[]).indexOf(b);
	if (ia !== -1 && ib !== -1) return ia - ib;
	if (ia !== -1) return -1;
	if (ib !== -1) return 1;
	return a.localeCompare(b);
});

// Journey section: PAST stages only, in journey order. A stage
// renders ONLY when it has at least one visible skill. Software
// Development is NOT a stage here — the detailed skills above ARE
// the last step; the timeline below ends in a "Today" node pointing
// back up to them.
const JOURNEY_STAGES = [
	{ stage: "graphic_design", label: t.stageGraphicDesign, note: t.stageGraphicDesignNote },
	{ stage: "digital_marketing", label: t.stageDigitalMarketing, note: t.stageDigitalMarketingNote },
] as const;
const journey = JOURNEY_STAGES.map(({ stage, label, note }) => ({
	label,
	note,
	skills: visible.filter((tech) => (tech.journeyStage ?? "software") === stage),
})).filter((s) => s.skills.length > 0);
---

<Layout
	title={t.skillsPageTitle}
	description={t.skillsPageDescription}
	lang={lang}
>
	<section class="glass">
		<p style="margin:0 0 8px;">
			<a class="back-link" href={langUrl("/", lang)}>{t.backHome}</a>
		</p>
		<h1 class="skills-hero-h1" style="margin:0 0 8px;font-size:24px;line-height:1.25;">{t.allSkills}</h1>
		{
			visible.length === 0 ? (
				<p class="empty-state">{t.emptySkills}</p>
			) : (
				<>
					<StackGlobe
						lang={lang}
						dict={pickDict(t, STACK_GLOBE_DICT_KEYS)}
						techs={visible}
						iconOnly
						client:visible
					/>
					{software.length > 0 && (
						<section aria-label={t.skillsMainTitle} id="skills-main">
							<h2 class="detail-h2">{t.skillsMainTitle}</h2>
							<p style="margin:0 0 16px;color:var(--ink-dim);">{t.skillsMainIntro}</p>
							{categories.map((category) => (
								<div style="margin-bottom:20px;">
									<h3 class="skills-h3">{category}</h3>
									<div class="skill-grid">
										{byCategory.get(category)!.map((tech) => (
											<div class="skill-card">
												<div class="skill-name">
													{tech.icon ? (
														<BrandIcon icon={tech.icon} name={tech.name} size={16} decorative />
													) : null}
													<span>{tech.name}</span>
												</div>
												{tech.use && <p class="skill-use">{tech.use}</p>}
												{tech.proficiency !== undefined && (
													<div class="skill-proficiency">
														<div class="skill-bar">
															<span style={`width:${tech.proficiency}%`} />
														</div>
														<span class="skill-pct">{tech.proficiency}%</span>
													</div>
												)}
											</div>
										))}
									</div>
								</div>
							))}
						</section>
					)}
					{journey.length > 0 && (
						<section aria-label={t.skillsJourneyTitle} class="journey-section">
							<h2 class="detail-h2">{t.skillsJourneyTitle}</h2>
							<p class="journey-intro">{t.skillsJourneyIntro}</p>
							<ol class="journey-timeline">
								{journey.map((stage) => (
									<li class="journey-step">
										<span class="journey-dot" aria-hidden="true" />
										<h3 class="journey-step-title">{stage.label}</h3>
										<p class="journey-step-note">{stage.note}</p>
									</li>
								))}
								<li class="journey-step journey-step-today">
									<span class="journey-dot journey-dot-today" aria-hidden="true" />
									<h3 class="journey-step-title">{t.skillsJourneyTodayTitle}</h3>
									<p class="journey-step-note">{t.skillsJourneyTodayNote}</p>
									<a class="journey-up" href="#skills-main">
										↑ {t.skillsMainTitle}
									</a>
								</li>
							</ol>
						</section>
					)}
				</>
			)
		}
	</section>
</Layout>

<style>
	.skills-h3 {
		font-size: 16px;
		line-height: 1.35;
		margin: 0 0 10px;
	}
	.skills-hero-h1 {
		text-align: center;
	}
	.skill-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
		gap: 10px;
	}
	.skill-card {
		border: 1px solid var(--card-border);
		border-radius: 12px;
		padding: 12px 14px;
		background: var(--card);
		transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
	}
	.skill-card:hover {
		transform: translateY(-2px);
		border-color: var(--accent);
		box-shadow: 0 6px 18px rgba(12, 26, 21, 0.08);
	}
	@media (prefers-reduced-motion: reduce) {
		.skill-card {
			transition: none;
		}
		.skill-card:hover {
			transform: none;
		}
	}
	.skill-name {
		display: flex;
		align-items: center;
		gap: 8px;
		font-weight: 600;
	}
	.skill-use {
		margin: 6px 0 0;
		font-size: 13px;
		color: var(--ink-dim);
	}
	/* Dark mode (PR #37): the muted teal-grey subtext under skill
	   names is low-contrast on the dark tile — lifted so it stays
	   readable without going bright. */
	[data-theme="dark"] .skill-use {
		color: #b9c9bf;
	}
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme="light"]) .skill-use {
			color: #b9c9bf;
		}
	}
	.skill-proficiency {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-top: 10px;
	}
	.skill-bar {
		flex: 1;
		height: 6px;
		border-radius: 3px;
		background: var(--accent-wash);
		overflow: hidden;
	}
	.skill-bar span {
		display: block;
		height: 100%;
		border-radius: 3px;
		background: var(--accent);
	}
	.skill-pct {
		font-size: 12px;
		color: var(--ink-dim);
		font-variant-numeric: tabular-nums;
	}
	/* Journey timeline (PR #28): past stages only, vertical spine;
	   the "Today" node ends the line and points back up to the
	   detailed skills above — the last step of the journey. */
	.journey-section {
		margin-top: 40px;
	}
	.journey-intro {
		margin: 0 0 24px;
		color: var(--ink-dim);
	}
	.journey-timeline {
		list-style: none;
		margin: 0;
		padding: 0;
		position: relative;
	}
	.journey-timeline::before {
		content: "";
		position: absolute;
		left: 7px;
		top: 8px;
		bottom: 8px;
		width: 2px;
		background: linear-gradient(var(--accent), transparent);
		opacity: 0.45;
	}
	.journey-step {
		position: relative;
		padding: 0 0 28px 32px;
	}
	.journey-step:last-child {
		padding-bottom: 0;
	}
	.journey-dot {
		position: absolute;
		left: 0;
		top: 4px;
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background: var(--bg);
		border: 2px solid var(--accent);
	}
	.journey-dot-today {
		background: var(--accent);
		box-shadow:
			0 0 0 4px var(--accent-wash),
			0 0 16px rgba(13, 148, 136, 0.45);
	}
	/* Dark mode (PR #37): the "Today" dot's halo uses the LIGHT-mode
	   teal — murky over black. Bright teal halo. */
	[data-theme="dark"] .journey-dot-today {
		box-shadow:
			0 0 0 4px rgba(45, 212, 191, 0.18),
			0 0 18px rgba(45, 212, 191, 0.55);
	}
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme="light"]) .journey-dot-today {
			box-shadow:
				0 0 0 4px rgba(45, 212, 191, 0.18),
				0 0 18px rgba(45, 212, 191, 0.55);
		}
	}
	.journey-step-title {
		font-size: 16px;
		line-height: 1.35;
		margin: 0 0 4px;
	}
	.journey-step-note {
		margin: 0;
		font-size: 14px;
		color: var(--ink-dim);
	}
	.journey-step-today .journey-step-title {
		color: var(--accent-strong);
	}
	.journey-up {
		display: inline-block;
		margin-top: 8px;
		font-size: 13px;
		font-weight: 600;
		color: var(--accent-strong);
		text-decoration: none;
	}
	.journey-up:hover {
		text-decoration: underline;
	}
</style>
